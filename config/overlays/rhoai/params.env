# Red Hat OpenShift AI specific parameters
# All resources deployed in redhat-ods-applications namespace

# RHOAI Spark Operator image
# TODO: Update image refs after Konflux onboarding
RELATED_IMAGE_ODH_SPARK_OPERATOR_IMAGE=na.artifactory.swg-devops.com/sys-linux-power-team-ftp3distro-docker-images-docker-local/spark-operator:odh
OPERATOR_VERSION=2.4.0

# Image variables used by ODH operator's ApplyParams
# These get substituted in the deployment YAMLs
SPARK_OPERATOR_CONTROLLER_IMAGE=na.artifactory.swg-devops.com/sys-linux-power-team-ftp3distro-docker-images-docker-local/spark-operator:odh
SPARK_OPERATOR_WEBHOOK_IMAGE=na.artifactory.swg-devops.com/sys-linux-power-team-ftp3distro-docker-images-docker-local/spark-operator:odh

# Namespace configuration
OPERATOR_NAMESPACE=redhat-ods-applications
